{
  "expo": {
    "name": "Control Asistencia CFOR",
    "slug": "control-asistencia-cfor",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logoAppCfor.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/logoAppCfor.png",
      "resizeMode": "contain",
      "backgroundColor": "#141810"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.cfor.asistencia"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#141810",
        "foregroundImage": "./assets/logoAppCfor.png"
      },
      "package": "com.cfor.asistencia"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sharing"
    ]
  }
}